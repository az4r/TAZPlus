(defun taz_wczytaj_warstwy()
  (setq taz_aktualna_warstwa (getvar "CLAYER"))
  (if (tblsearch "LAYER" "taz___thin")
    (princ)
    (command "_layer" "_M" "taz___thin" "_C" "1" "" "")
  )
  (if (tblsearch "LAYER" "taz___view")
    (princ)
    (command "_layer" "_M" "taz___view" "_C" "2" "" "")
  )
  (if (tblsearch "LAYER" "taz___section")
    (princ)
    (command "_layer" "_M" "taz___section" "_C" "3" "" "")
  )
  (if (tblsearch "LAYER" "taz___hidden")
    (princ)
    (progn
      (if (tblsearch "LTYPE" "HIDDEN")
        (princ)
        (command "_linetype" "_L" "HIDDEN" "gcadiso.lin" "")
      )
      (command "_layer" "_M" "taz___hidden" "_C" "4" "" "_L" "HIDDEN" "" "")
    )
  )
  (if (tblsearch "LAYER" "taz___help")
    (princ)
    (command "_layer" "_M" "taz___help" "_C" "6" "" "_P" "_N" "" "")
  )
  (if (tblsearch "LAYER" "taz___cut")
    (princ)
    (progn
      (if (tblsearch "LTYPE" "DASHED")
        (princ)
        (command "_linetype" "_L" "DASHED" "gcadiso.lin" "")
      )
      (command "_layer" "_M" "taz___cut" "_C" "1" "" "_L" "DASHED" "" "")
    )
  )
  (if (tblsearch "LAYER" "taz___axis")
    (princ)
    (progn
      (if (tblsearch "LTYPE" "CENTER")
        (princ)
        (command "_linetype" "_L" "CENTER" "gcadiso.lin" "")
      )
      (command "_layer" "_M" "taz___axis" "_C" "7" "" "_L" "CENTER" "" "")
    )
  )
  (if (tblsearch "LAYER" "taz___hatch")
    (princ)
    (command "_layer" "_M" "taz___hatch" "_C" "8" "" "")
  )
  (if (tblsearch "LAYER" "taz___text")
    (princ)
    (command "_layer" "_M" "taz___text" "_C" "1" "" "")
  )
  (command "_layer" "_S" taz_aktualna_warstwa "")
  (princ)
)

(defun taz_warstwa_zero()
  (command "_layer" "_S" "0" "")
  (princ)
)

(defun taz_warstwa_thin()
  (if (tblsearch "LAYER" "taz___thin")
